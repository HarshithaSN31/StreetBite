# ==============================================================================
# StreetBite Environment Configuration
# ==============================================================================

# Google Maps Platform API Key (Optional but Recommended)
# Used for:
# 1. Reverse geocoding in `/api/geocode` (high-accuracy GPS coordinate lookup)
# 2. Client-side embedded maps and direct navigation links
#
# NOTE: If this key is not provided, StreetBite automatically falls back to:
# - OpenStreetMap (OSM) Nominatim reverse geocoding
# - Direct Google Maps navigation URL links (https://www.google.com/maps/dir/?api=1&destination=lat,lng)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_API_KEY=

# Application Port (Default 3000)
PORT=3000

# Node Environment
NODE_ENV=development
